# Example environment variables for Weekly Planner Remix App
# Copy this file to ".env" and customize for your setup.
# (This app runs fully in-memory, so no secrets are required by default.)

# Example: Set the Remix port. Defaults to 3000 if unset.
# PORT=3000

# Example: For deploys, Node environment mode (uncomment as needed)
# NODE_ENV=development
# NODE_ENV=production
